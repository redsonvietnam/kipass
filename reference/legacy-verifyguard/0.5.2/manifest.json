{
  "manifest_version": 3,
  "name": "VerifyGuard — Safe Verification Assistant",
  "short_name": "VerifyGuard",
  "version": "0.5.2",
  "description": "Ẩn banner và iframe quảng cáo có dấu hiệu quảng cáo rõ ràng; hỗ trợ Continue/Verify sau timer, dừng khi gặp CAPTCHA hoặc lỗi.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "VerifyGuard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kipascommunity.com/*",
        "https://rm358.com/*",
        "https://faxro.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kipascommunity.com/verify/*"
      ],
      "css": [
        "kipas-ads.css"
      ],
      "js": [
        "main-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kipascommunity.com/verify/*"
      ],
      "js": [
        "auto-run.js"
      ],
      "run_at": "document_idle"
    }
  ]
}